<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <!--
        Injects the Sentry Browser SDK loader into every web page when
        the ir.config_parameter `sentry.browser_loader_url` is set.

        Session Replay (and browser-side error/performance capture) can
        only be recorded by the JavaScript SDK in the user's browser -
        the Python SDK has no access to the DOM. Configure the loader in
        Sentry: Settings -> Projects -> Loader Script (enable Session
        Replay and pick sample rates there), then store its URL in the
        system parameter. Leave the parameter empty to disable.
    -->
    <template
        id="sentry_browser_loader"
        inherit_id="web.layout"
        name="Sentry Browser SDK / Session Replay"
    >
        <xpath expr="//head" position="inside">
            <!-- the loader only injects in javascript mode (server
                 config sentry_mode); in python mode Sentry stays a
                 pure backend integration -->
            <t
                t-set="sentry_browser_loader_url"
                t-value="request and request.env['ir.http'].sentry_frontend_enabled() and request.env['ir.config_parameter'].sudo().get_param('sentry.browser_loader_url')"
            />
            <t t-if="sentry_browser_loader_url">
                <t
                    t-set="sentry_replay_session_rate"
                    t-value="request.env['ir.config_parameter'].sudo().get_param('sentry.replay_session_sample_rate')"
                />
                <t
                    t-set="sentry_replay_error_rate"
                    t-value="request.env['ir.config_parameter'].sudo().get_param('sentry.replay_error_sample_rate')"
                />
                <t
                    t-set="sentry_replay_options"
                    t-value="request.env['ir.http'].sentry_replay_options()"
                />
                <t t-set="sentry_replay_user" t-value="sentry_replay_options['user']" />
                <!-- The loader defaults to a 10% session sample rate;
                     override it via the sentry.replay_*_sample_rate
                     system parameters (values 0.0 to 1.0). The raw
                     values are passed as data attributes (plain XML
                     attribute escaping, no code generation) and parsed
                     in the browser, so an invalid parameter falls back
                     to the defaults instead of breaking page
                     rendering. The same attributes carry the opt-in
                     user identification and the RPC-error flush flag
                     (see ir.http.sentry_replay_options). -->
                <script
                    t-if="sentry_replay_session_rate or sentry_replay_error_rate or sentry_replay_user or sentry_replay_options['flush_on_rpc_error'] or sentry_replay_options['feedback_widget'] is not None"
                    t-att-data-session-rate="sentry_replay_session_rate"
                    t-att-data-error-rate="sentry_replay_error_rate"
                    t-att-data-user-id="sentry_replay_user and sentry_replay_user['id']"
                    t-att-data-user-login="sentry_replay_user and sentry_replay_user['login']"
                    t-att-data-user-name="sentry_replay_user and sentry_replay_user['name']"
                    t-att-data-flush-on-rpc-error="sentry_replay_options['flush_on_rpc_error'] and '1'"
                    t-att-data-feedback-widget="sentry_replay_options['feedback_widget'] is not None and ('1' if sentry_replay_options['feedback_widget'] else '0')"
                >
(function () {
    var data = document.currentScript.dataset;
    var sessionRate = parseFloat(data.sessionRate);
    var errorRate = parseFloat(data.errorRate);
    window.sentryReplayFlushOnRpcError = data.flushOnRpcError === "1";
    window.sentryOnLoad = function () {
        var options = {
            replaysSessionSampleRate: isNaN(sessionRate) ? 0.1 : sessionRate,
            replaysOnErrorSampleRate: isNaN(errorRate) ? 1.0 : errorRate,
        };
        if (data.feedbackWidget !== undefined) {
            // overrides the Loader's own setting for the user-feedback button
            options.autoInjectFeedback = data.feedbackWidget === "1";
        }
        Sentry.init(options);
        if (data.userId) {
            Sentry.setUser({
                id: data.userId,
                username: data.userLogin,
                name: data.userName,
            });
        }
    };
})();
                </script>
                <script t-att-src="sentry_browser_loader_url" crossorigin="anonymous" />
            </t>
        </xpath>
    </template>
</odoo>
